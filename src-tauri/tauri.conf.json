{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sunucu Analiz - Foxivo",
  "mainBinaryName": "sunucu-analiz",
  "version": "../package.json",
  "identifier": "tr.com.foxivo.sunucuanaliz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sunucu Analiz - Foxivo",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 720,
        "center": true,
        "decorations": false,
        "backgroundColor": "#121215",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb"
    ],
    "publisher": "Foxivo",
    "copyright": "© 2026 Foxivo",
    "homepage": "https://foxivo.com.tr",
    "category": "Utility",
    "shortDescription": "Minecraft sunucu sağlık raporu",
    "longDescription": "Minecraft sunucu klasörünü salt okunur tarar, sağlık raporu çıkarır ve onayınla güvenle düzeltir.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMTZDMkI4N0RFNjcyQjMKUldTemN1Wjl1TUlXUXVDWHZ1RHVkVmRvWHorWnZmT29COFBkL1NBYlBXTXdKTnpZUTZDQ2ZWRkUK",
      "endpoints": [
        "https://github.com/foxivosoftware/sunucu-analiz-foxivo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
