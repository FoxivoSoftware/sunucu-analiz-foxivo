{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$locales/*": ["./locales/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "locales/*.json"]
}
